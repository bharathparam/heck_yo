# RailBus Backend Environment Variables Configuration Template
# Set DEBUG=true for local development, DEBUG=false for staging/production

DEBUG=true
PROJECT_NAME="RailBus Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite by default, or Postgres async: postgresql+asyncpg://user:pass@localhost:5432/railbus)
DATABASE_URL="sqlite+aiosqlite:///./railbus.db"
DATABASE_ECHO=false

# Security & Authentication Secrets (Required to be set to custom secure strings in production when DEBUG=false)
SECRET_KEY="railbus-production-jwt-secret-replace-in-env-key-928374928"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ticket HMAC QR Signature Secret
QR_HMAC_SECRET="railbus-qr-signature-secret-key-3847293847293847"
TICKET_VALIDITY_WINDOW_HOURS=6

# Dynamic Demand Activation Threshold
DEMAND_ACTIVATION_THRESHOLD=20

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
